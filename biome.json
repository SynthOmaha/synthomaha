{
    "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
    "extends": ["@taraxvoid/voidflow/biome"],
    "formatter": {
        "includes": ["**", "!**/bun.lock", "!**/deno.lock", "!public/admin/**"]
    },
    "linter": {
        "includes": ["**", "!.astro/**", "!public/admin/**", "!public/**/*.svg"]
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
